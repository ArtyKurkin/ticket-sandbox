DEBUG=False
SECRET_KEY=change-me-to-a-long-random-secret

ALLOWED_HOSTS=training.example.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://training.example.com
EXTERNAL_HOST=training.example.com

SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0

DB_ENGINE=django.db.backends.postgresql
DB_NAME=training_platform
DB_USER=training_platform_user
DB_PASSWORD=change-me-to-a-strong-database-password
DB_HOST=db
DB_PORT=5432

TERMINAL_GATEWAY_ENABLED=true
TERMINAL_NETWORK_MODE=docker_network
TERMINAL_DOCKER_NETWORK=training-platform-runtime

CHECK_TASK_TIMEOUT_SECONDS=60
LOG_LEVEL=INFO

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

TIME_ZONE=Europe/Moscow
TASK_CONTAINER_TZ=MSK-3