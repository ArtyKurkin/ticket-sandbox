# Public template only. Copy outside Git to a private release directory (chmod 600).
# Fill ALL values from reviewed artifacts and current container/image inspection.
# Use registry/name@sha256:<64 hex> or a local sha256:<64 hex> image ID.
# Web, Worker and Scheduler may intentionally have different revisions.
WEB_IMAGE=
WORKER_IMAGE=
SCHEDULER_IMAGE=
GATEWAY_IMAGE=
POSTGRES_IMAGE=
REDIS_IMAGE=
BROKER_IMAGE=
TTYD_IMAGE=
# This is a non-secret callback URL, not a public Gateway endpoint.
BROKER_AUTHORIZATION_URL=http://web:8000/terminal-broker-auth/
